# =============================================================================
#  E-commerce Big Data Platform (REES46-only scope) — environment variables
#  Copy to .env:  cp .env.example .env   (make init does this for you)
#  NEVER commit .env. Values below are LOCAL-DEV defaults only.
# =============================================================================

COMPOSE_PROJECT_NAME=ecom
TZ=UTC

# -----------------------------------------------------------------------------
# Image / library versions (pin everything; bump deliberately)
# -----------------------------------------------------------------------------
PYTHON_VERSION=3.11
SPARK_VERSION=3.5.5
DELTA_VERSION=3.3.2
SCALA_BINARY=2.12
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262
KAFKA_IMAGE=apache/kafka:3.9.1
CP_VERSION=7.9.1
S3_SINK_CONNECTOR_VERSION=latest
# MinIO stopped publishing community images to Docker Hub (Oct 2025).
# quay.io mirror keeps the last community release; alternatives: pgsty/minio, cgr.dev/chainguard/minio
MINIO_IMAGE=quay.io/minio/minio:latest
AWS_CLI_IMAGE=amazon/aws-cli:2.17.0
# Hive 4.0.1+ dropped thrift methods used by older clients -> stay on 4.0.0
HIVE_IMAGE=apache/hive:4.0.0
HIVE_HADOOP_VERSION=3.3.6
HIVE_AWS_SDK_VERSION=1.12.367
POSTGRES_JDBC_VERSION=42.7.4
TRINO_VERSION=476
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.3
REDIS_IMAGE=redis:7.4-alpine
POSTGRES_IMAGE=postgres:16-alpine
AIRFLOW_VERSION=3.3.0
DBT_TRINO_VERSION=1.9.0
GRAFANA_IMAGE=grafana/grafana:11.6.0
SUPERSET_VERSION=4.1.2
MLFLOW_VERSION=2.22.0
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.8.0
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:latest

# -----------------------------------------------------------------------------
# Host ports (change if they collide with something on your machine)
# -----------------------------------------------------------------------------
KAFKA_EXTERNAL_PORT=29092
SCHEMA_REGISTRY_PORT=8081
KAFKA_CONNECT_PORT=8083
KAFKA_UI_PORT=8085
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
REDIS_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
SPARK_MASTER_UI_PORT=8080
SPARK_DRIVER_UI_PORT=4040
TRINO_PORT=8090
AIRFLOW_PORT=8091
GRAFANA_PORT=3000
SUPERSET_PORT=8088
JUPYTER_PORT=8888
MLFLOW_PORT=5000
RECOMMEND_API_PORT=8000
PROMETHEUS_PORT=9090
PRODUCER_METRICS_PORT=8001

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
# Any 22-char base64 UUID; generate a new one with: docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
# Dev = 1 broker -> RF 1. In a 3-broker cluster set RF=3, min ISR=2.
KAFKA_REPLICATION_FACTOR=1
TOPIC_CLICKSTREAM=ecom.clickstream.v1
TOPIC_CLICKSTREAM_DLQ=ecom.clickstream.dlq
TOPIC_SESSIONS=agg.sessions
TOPIC_ALERT_CART=alerts.cart_abandon
TOPIC_ALERT_BOT=alerts.bot
TOPIC_RECO_IMPRESSIONS=reco.impressions
CLICKSTREAM_PARTITIONS=12

# -----------------------------------------------------------------------------
# Object storage (MinIO / S3)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
LAKEHOUSE_BUCKET=lakehouse
CHECKPOINT_BUCKET=checkpoints
MLFLOW_BUCKET=mlflow

# -----------------------------------------------------------------------------
# Postgres (one instance, several logical DBs: metastore, airflow, mlflow, superset)
# -----------------------------------------------------------------------------
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform123
METASTORE_DB=metastore
METASTORE_DB_USER=hive
METASTORE_DB_PASSWORD=hive123
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow123
MLFLOW_DB=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow123
SUPERSET_DB=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset123

# -----------------------------------------------------------------------------
# Serving stores
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=redis123
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_USER=platform
CLICKHOUSE_PASSWORD=platform123
CLICKHOUSE_DB=realtime
TRINO_HOST=trino
TRINO_INTERNAL_PORT=8080
TRINO_CATALOG=delta

# -----------------------------------------------------------------------------
# Spark
# -----------------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g
# Comma separated: funnel,trending,sessionization,session_state,bot,revenue  (or "all")
STREAMING_JOBS=all
STREAMING_TRIGGER_SECONDS=10
STREAMING_WATERMARK="2 minutes"
STREAMING_MAX_OFFSETS_PER_TRIGGER=200000
TRENDING_TOP_K=20
BOT_ZSCORE_THRESHOLD=3.0
BOT_MIN_EVENTS_10S=20
CART_ABANDON_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------------
# Clickstream producer (REES46 replay)
# -----------------------------------------------------------------------------
REES46_INPUT=/data/raw/2019-Oct.csv.gz
REPLAY_SPEED=10
REPLAY_TIME_MODE=shift
REPLAY_MAX_EVENTS=0
CHAOS_ENABLED=false
CHAOS_LATE_RATIO=0.02
CHAOS_DUP_RATIO=0.01
CHAOS_BOT_BURST_PROB=0.0005
CHAOS_LATE_DELAY_SECONDS=240
# Kaggle API (only needed for scripts/download_rees46.sh)
KAGGLE_USERNAME=
KAGGLE_KEY=

# -----------------------------------------------------------------------------
# Airflow 3
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000
# generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-dev-jwt-secret-0123456789
AIRFLOW_API_SECRET=change-me-dev-api-secret-0123456789

# -----------------------------------------------------------------------------
# BI / ML
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin123
SUPERSET_SECRET_KEY=change-me-dev-superset-secret-0123456789
JUPYTER_TOKEN=ecom
MLFLOW_TRACKING_URI=http://mlflow:5000
INTENT_MODEL_URI=models:/purchase_intent@champion
RECS_TOP_N=50
# Timeline ML features/training are anchored on: auto (bulk history if loaded, else replay) | bulk_csv | kafka_connect | all
ML_SOURCE=auto
API_DEFAULT_K=10
